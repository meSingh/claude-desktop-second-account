#!/bin/bash
# __NAME__ launcher (generated by the claude-desktop-second-account skill).
#
# Runs a private, unmodified copy of Claude.app with its own profile folder and
# its own Claude Code config, so a second account can run alongside the first.
# The copy exists only so macOS shows a different Dock icon for this instance.
#
#   launch.sh              refresh the copy if needed, restore its icon, start it
#   launch.sh --icon-only  just restore the icon (used by the optional watcher)
set -u

NAME="__NAME__"
SRC="/Applications/Claude.app"
CLONE_DIR="$HOME/Library/Application Support/${NAME}-App"
CLONE="$CLONE_DIR/${NAME}.app"
PROFILE="$HOME/Library/Application Support/${NAME}"
CONFIG="__CONFIG_DIR__"
ICON="$(cd "$(dirname "$0")" && pwd)/applet.icns"

ver() {
  # PlistBuddy prints "File Doesn't Exist" on stdout, so check the file and the format.
  local v
  [ -f "$1/Contents/Info.plist" ] || return 0
  v="$(/usr/libexec/PlistBuddy -c "Print :CFBundleVersion" "$1/Contents/Info.plist" 2>/dev/null)" || return 0
  [[ "$v" =~ ^[0-9][0-9.]*$ ]] && printf '%s' "$v"
  return 0
}
running() { /usr/bin/pgrep -f "$CLONE/Contents/MacOS/Claude" >/dev/null; }
has_icon() { [ -e "$CLONE/Icon"$'\r' ]; }
set_icon() {
  # Same as Finder "Get Info > paste icon": adds a custom-icon file to the bundle
  # folder and leaves every signed file inside the app untouched.
  /usr/bin/osascript -l JavaScript -e 'function run(a){ObjC.import("AppKit");return $.NSWorkspace.sharedWorkspace.setIconForFileOptions($.NSImage.alloc.initWithContentsOfFile(a[0]),a[1],0)}' "$ICON" "$CLONE" >/dev/null
  # Make LaunchServices re-read the bundle now. Otherwise an app started right
  # after an update can keep the default Dock icon until its next launch.
  touch "$CLONE"
  /System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$CLONE" >/dev/null 2>&1
  ICON_JUST_SET=1
}
ICON_JUST_SET=0

if [ "${1:-}" = "--icon-only" ]; then
  [ -d "$CLONE" ] && ! has_icon && set_icon
  exit 0
fi

[ -d "$SRC" ] || { /usr/bin/osascript -e "display alert \"$NAME\" message \"Claude.app was not found in /Applications.\""; exit 1; }
mkdir -p "$CLONE_DIR" "$PROFILE" "$CONFIG"

# Re-clone only when the installed Claude.app is newer than our copy. The copy
# also auto-updates itself, so never replace a newer copy with an older app.
src_v="$(ver "$SRC")"; dst_v="$(ver "$CLONE")"
newest="$(printf '%s\n%s\n' "$src_v" "$dst_v" | sort -V | tail -1)"
if ! running && { [ -z "$dst_v" ] || { [ "$src_v" != "$dst_v" ] && [ "$newest" = "$src_v" ]; }; }; then
  rm -rf "$CLONE.tmp"
  # -c makes an APFS clone: near-zero extra disk until files diverge.
  if /bin/cp -cRp "$SRC" "$CLONE.tmp"; then
    rm -rf "$CLONE" && mv "$CLONE.tmp" "$CLONE"
  fi
fi
[ -d "$CLONE" ] || { /usr/bin/osascript -e "display alert \"$NAME\" message \"Could not create the app copy in $CLONE_DIR.\""; exit 1; }
has_icon || set_icon
[ "$ICON_JUST_SET" = 1 ] && sleep 1   # let the Dock pick up the new icon before launch

# Keep the Code config linked to ~/.claude: new skills and plugins show up via
# symlinks, and settings plus Code and desktop MCP servers are re-merged here
# while the app is closed. Skipped if python3 isn't installed, so it never
# prompts for tools.
LINKER="$(cd "$(dirname "$0")" && pwd)/link_shared.py"
if [ "__LINK__" = 1 ] && [ -f "$LINKER" ] && ! running && /usr/bin/xcode-select -p >/dev/null 2>&1; then
  /usr/bin/python3 -I "$LINKER" --to "$CONFIG" --profile "$PROFILE" --auto --yes >/dev/null 2>&1 || true
fi

/usr/bin/open -n --env CLAUDE_CONFIG_DIR="$CONFIG" "$CLONE" --args --user-data-dir="$PROFILE"
